# ══════════════════════════════════════════════════════════════
#  Pixel Parties — Caddy-Konfiguration
#
#  Ziel: /etc/caddy/Caddyfile — deploy/setup.sh legt dorthin einen
#  Symlink, damit die Konfiguration versioniert bleibt und nicht
#  irgendwann nur noch auf dem Server existiert.
#
#  Caddy holt und erneuert die Let's-Encrypt-Zertifikate selbst und
#  reicht WebSocket-Upgrades ohne jede Zusatzkonfiguration durch.
#  X-Forwarded-For, -Proto und -Host setzt reverse_proxy ebenfalls
#  von allein — deshalb steht hier bewusst nichts davon.
# ══════════════════════════════════════════════════════════════

{
        email alexander.schiffke@t-online.de
}

(pixelparties) {
        encode zstd gzip
        request_body {
                max_size 12MB
        }
        # MoniaBot-Schnittstelle: nur der Bot auf diesem Server darf sie aufrufen (direkt auf 127.0.0.1:3000).
        # Von außen gibt es sie nicht — selbst mit gültigem Geheimnis nicht.
        @botapi path /api/bot /api/bot/*
        respond @botapi 404
        # Sicherheits-Header (Audit 25.11.). Die App setzt dieselben selbst; hier stehen sie zusaetzlich, damit auch Fehlerseiten von Caddy
        # und Antworten ohne Node sie tragen. Kein HSTS-includeSubDomains: andere Subdomains sind nicht Teil dieses Dienstes.
        header {
                Strict-Transport-Security "max-age=31536000"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                -Server
        }
        reverse_proxy 127.0.0.1:3000
        log {
                output file /var/log/caddy/pixelparties.log {
                        roll_size 20MiB
                        roll_keep 5
                }
        }
}

pixelpartiestcg.com {
        import pixelparties
}

neu.pixelpartiestcg.com {
        import pixelparties
}

# www.* auf die Hauptdomain umleiten (ein Host im Index, keine Dubletten). Braucht einen DNS-Eintrag fuer www.
www.pixelpartiestcg.com {
        redir https://pixelpartiestcg.com{uri} permanent
}
