# ══════════════════════════════════════════════════════════════
#  Pixel Parties — Caddy-Konfiguration
#
#  Ziel: /etc/caddy/Caddyfile — deploy/setup.sh legt dorthin einen
#  Symlink, damit die Konfiguration versioniert bleibt und nicht
#  irgendwann nur noch auf dem Server existiert.
#
#  Caddy holt und erneuert die Let's-Encrypt-Zertifikate selbst und
#  reicht WebSocket-Upgrades ohne jede Zusatzkonfiguration durch.
#  X-Forwarded-For, -Proto und -Host setzt reverse_proxy ebenfalls
#  von allein — deshalb steht hier bewusst nichts davon.
# ══════════════════════════════════════════════════════════════

{
	# Adresse für Ablaufwarnungen von Let's Encrypt. MUSS gesetzt werden.
	email DEINE-MAILADRESSE
}

(pixelparties) {
	encode zstd gzip

	# Avatare und Kartenrückseiten sind die einzigen Uploads.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/pixelparties.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# ── STUFE 1+2: Testbetrieb parallel zu Render ─────────────────
neu.pixelpartiestcg.com {
	import pixelparties
}

# ── STUFE 3: Umschaltung ──────────────────────────────────────
# Erst einkommentieren, wenn der A-Record von pixelpartiestcg.com
# tatsächlich auf diesen Server zeigt. Vorher scheitert die
# Zertifikatsausstellung — Let's Encrypt prüft über genau diesen
# Namen — und Caddy läuft in eine Wiederholungsschleife.
#
# pixelpartiestcg.com, www.pixelpartiestcg.com {
# 	import pixelparties
# }
