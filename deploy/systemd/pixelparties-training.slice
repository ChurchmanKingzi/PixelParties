# Ressourcengruppe für Trainingsläufe (netbench, Sammelläufe).
#
# Nachrangig gegenüber pixelparties.slice. Wichtig ist vor allem die
# CPUQuota: Sie hält einen der vier Kerne frei, damit der Spielserver
# und die SSH-Sitzung auch dann noch antworten, wenn ein Sammellauf
# alles gibt, was er kriegen kann.

[Unit]
Description=Pixel Parties — Trainingsläufe (nachrangig)
Before=slices.target

[Slice]
# Muss über PP_TRAIN_HEAP_MAX (3072) plus Node-Grundlast liegen, sonst
# killt der Kernel den Kindprozess, bevor V8 sein eigenes Limit meldet —
# wortloser Abbruch statt Stacktrace.
MemoryHigh=3500M
MemoryMax=4G
# 300% = drei von vier Kernen. Der vierte bleibt dem Spiel.
CPUQuota=300%
CPUWeight=100
IOWeight=100
