{
  "name": "pixel-parties-desktop",
  "version": "1.0.0",
  "description": "Desktop (Electron) shell for Pixel Parties TCG — wraps the web client for Steam distribution.",
  "main": "main.js",
  "author": "ChurchmanKingzi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "dist:win-dir": "electron-builder --win --dir",
    "dist:linux-dir": "electron-builder --linux --dir",
    "dist:win-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pixelparties.tcg",
    "productName": "Pixel Parties",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "launcher.html",
      "launcher-config.json",
      "desktop-secrets.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "PixelParties-portable.exe"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "PixelParties",
      "extraFiles": [
        {
          "from": "itch/linux.itch.toml",
          "to": ".itch.toml"
        }
      ]
    },
    "publish": null,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "de"
    ]
  }
}
