# MoniaBot — Einstellungen. Kopieren nach bot/.env und ausfüllen:  cp .env.example .env
# Diese Datei NIE ins Repo und nie in einen Chat stellen: DISCORD_TOKEN ist das Passwort des Bots.

# ── Pflicht ────────────────────────────────────────────────────────
# Developer Portal → Anwendung → Bot → „Reset Token“ (wird nur EINMAL angezeigt)
DISCORD_TOKEN=
# Discord → Servereinstellungen → Erweitert → Entwicklermodus an; dann Rechtsklick auf den Server → „Server-ID kopieren“
GUILD_ID=
# BOT_SECRET: Wert steht in /opt/pixelparties/.env (BOT_SECRET=…). Der Bot liest ihn von dort mit.
# Nur hier eintragen, wenn der Bot NICHT neben dem Spiel läuft:
# BOT_SECRET=

# ── Kanäle (Rechtsklick auf den Kanal → „Kanal-ID kopieren“). Leer lassen = Funktion aus. ──
WELCOME_CHANNEL_ID=          # leer: der „Systemnachrichten-Kanal“ des Servers
MODLOG_CHANNEL_ID=           # nur für Mods sichtbar: Strikes, Bans, Raid-Alarm
# (NEW_CARDS_CHANNEL_ID gibt es nicht mehr: der Kanal für neue Karten ist fest 774670375303905291 und lässt sich nicht per .env ändern)
PATCHNOTES_CHANNEL_ID=       # neue Commits als Patchnotes
# BUGFIXES_CHANNEL_ID=       # Bugfix-Feed (Standard: 1562197315437989889, nur eintragen zum Ändern)
LEADERBOARD_CHANNEL_ID=      # eine Nachricht, die der Bot laufend aktualisiert
CARD_OF_DAY_CHANNEL_ID=      # „Karte des Tages“ ab 12:00 Berliner Zeit
BUG_CHANNEL_ID=              # Ziel von /bug (nur fürs Team sichtbar)

# ── Optional ───────────────────────────────────────────────────────
# Wer Admin-Befehle benutzen darf (Rollennamen, kommagetrennt). Voreinstellung:
# ADMIN_ROLE_NAMES=Creator,Deputy Monia [MOD]
# ADMIN_ROLE_IDS=ID1,ID2               # EMPFOHLEN: Rollen-IDs von Creator und Deputy Monia [MOD]. Ist das gesetzt, zählen NUR diese IDs (Namen sind fälschbar).

# NEWCOMER_ROLE_ID=                     # Startrolle für neue Mitglieder
# VERIFIED_ROLE_ID=                     # Rolle, die der „I agree“-Button der Regel-Nachricht vergibt
# WELCOME_DM=0                          # 1 = zusätzlich eine kurze Privatnachricht
# SYNC_NICKNAMES=0                      # 1 = Server-Spitzname = Spielname (verknüpfte Spieler)

# NEW_MEMBER_DAYS=183                   # „weniger als ein halbes Jahr“
# MUTE_MINUTES=60
# STRIKE_LIMIT=3                        # so viele gültige Strikes = Bann
# STRIKE_EXPIRY_DAYS=90
# RAID_JOINS=8                          # Raid-Verdacht: so viele Beitritte …
# RAID_WINDOW_SEC=60                    # … in so vielen Sekunden
# RAID_LOCKDOWN_MINUTES=15              # so lange Verifizierungsstufe „Sehr hoch“ (0 = nur warnen)

# SKIN_COLLECTOR_MIN=50
# VETERAN_GAMES=300

# Minispiele (!mystery / !guess / !pixle). Alles optional — ohne Einträge gilt der fest eingestellte Minigames-Kanal.
# MINIGAMES_CHANNEL_ID=1561796630762623036      # (die ältere Variable MYSTERY_CHANNEL_ID wird weiter als Rückfall gelesen)
# MYSTERY_REWARD=20                     # SC für den Gewinner …
# MYSTERY_PENALTY=2                     # … minus so viel je eigenem falschem Tipp auf diese Karte
# PIXLE_MAX_GUESSES=10                  # Pixle: Tipps pro Spiel (nach jedem Spiel startet sofort ein neues)
# PIXLE_REWARD=30                       # Pixle: SC fürs Lösen der TÄGLICHEN Karte (einmal pro Tag; Übungsspiele zahlen nie) …
# PIXLE_PENALTY=3                       # … minus so viel je falschem Tipp davor (mindestens 3)

# /bug zusätzlich als GitHub-Issue (Token mit Berechtigung „Issues: Read and write“ für dieses Repo)
# GITHUB_TOKEN=
# GITHUB_REPO=ChurchmanKingzi/PixelParties
