node_modules/
public/dist/
data/pixel-parties.db
uploads/avatars/*
uploads/cardbacks/*
!uploads/avatars/.gitkeep
!uploads/cardbacks/.gitkeep
!cards/.gitkeep
.env
PPKeys
electron/desktop-secrets.json

# ML-Trainingsdaten (groß, wachsend, maschinenspezifisch, reproduzierbar)
# Beide Ordner legt der Code zur Laufzeit selbst an (mkdirSync recursive),
# ein .gitkeep ist also nicht nötig. Zur Laufzeit BRAUCHT das Spiel nichts
# daraus — die gelernten Profile liegen getrennt in data/cpu-profiles/ und
# bleiben ausdrücklich versioniert.
data/training/
data/coverage/
data/pc/

# Spielaufzeichnungen (seit 1.8. standardmäßig aktiv, wachsen im
# Live-Betrieb mit jeder Partie). Dauerhaft liegen sie ohnehin in der
# Datenbank (Tabelle demo_games), die Dateien sind nur der laufende
# Mitschnitt für die Einfrier-Forensik.
data/demo-games/

# Absturz-Forensik der Trainingsläufe. Liegt normalerweise neben der
# jsonl in data/training/ (schon erfasst) — die Regeln greifen auch,
# wenn PP_TRAIN_OUT woanders hinzeigt.
*.crash.json
*.inflight.json

# V8-Heap-Snapshots aus PP_TRAIN_HEAPSNAP=1 — landen im Wurzelverzeichnis
# und sind je nach Heap-Limit hunderte MB groß.
*.heapsnapshot

# SQLite-Nebendateien (die DB selbst ist schon ignoriert)
data/pixel-parties.db-journal
data/pixel-parties.db-wal
data/pixel-parties.db-shm
__pycache__/
data/shop/sleeve-entwuerfe/
data/shop/avatar-entwuerfe/

# Skill Test: Zwischendateien des Lernsystems (das Profil selbst data/skilltest-profile.json wird mit eingecheckt)
data/skilltest-profile.json.tmp-*

# MoniaBot (Discord-Bot, bot/): Abhängigkeiten, Zugangsdaten und die eigene Datenbank gehören nicht ins Repo
bot/node_modules/
bot/.env
bot/data/moniabot.db
bot/data/moniabot.db-*

# Nicht zum Spiel gehoerig (Al, 25.10.2026): Niche-Tests, Audits, Berichte und Dokumentation bleiben lokal — siehe CLAUDE.md / CARD_API.md
/docs/
*.md
!/CLAUDE.md
!/README.md
!/cards/effects/CARD_API.md
*.trail.json
*_report.csv
